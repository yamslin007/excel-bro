# OpenAI-compatible 模型服务。
# AI_BASE_URL 和 AI_MODEL 配好后即启用模型；本地无鉴权网关可以留空 AI_API_KEY。
# 也兼容 OPENAI_BASE_URL、OPENAI_MODEL、OPENAI_API_KEY。
AI_BASE_URL=https://api.moonshot.cn/v1
AI_API_KEY=
AI_MODEL=kimi-k3
# 可选：同一服务地址和 API Key 下允许用户切换的其他模型，用英文逗号分隔。
AI_MODELS=
# 可选：明确声明允许接收图片的模型，用英文逗号分隔；不会根据模型名称猜测能力。
AI_VISION_MODELS=
# 需求澄清是轻量调用，独立设置较短超时；确认后才进入完整分析。
AI_INTENT_TIMEOUT_SECONDS=60
AI_TIMEOUT_SECONDS=60
