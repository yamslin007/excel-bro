# OpenAI-compatible 模型服务。
# AI_BASE_URL 和 AI_MODEL 配好后即启用模型；本地无鉴权网关可以留空 AI_API_KEY。
# 也兼容 OPENAI_BASE_URL、OPENAI_MODEL、OPENAI_API_KEY。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 可选：同一服务地址和 API Key 下允许用户切换的其他模型，用英文逗号分隔。
AI_MODELS=
# 可选：明确声明允许接收图片的模型，用英文逗号分隔；不会根据模型名称猜测能力。
AI_VISION_MODELS=
# 需求澄清是轻量调用，独立设置较短超时；确认后才进入完整分析。
AI_INTENT_TIMEOUT_SECONDS=180
AI_TIMEOUT_SECONDS=180

# 可选：Anthropic 原生 Claude Agent SDK 连接；SDK 安装方法见 docs/DEVELOPMENT.md。
# 三项同时配置后，模型菜单会出现「Claude Agent SDK」。
# 已保存的官方 DeepSeek 连接可复用模型 ID 与 Key，另生成「Agent SDK」选项；无须在此重复填写。
# SDK 会在本机保存会话资料，目录必须是仓库外的绝对路径。
# 此接入仅发送本次需求和已授权表结构；需要数据行、图片的任务明确拒绝，不自动切换模型。
CLAUDE_AGENT_SDK_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_AGENT_SDK_STATE_DIR=
